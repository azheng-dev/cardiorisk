# =============================================================================
# CardioRisk Co-Pilot .gitignore
# Order: secrets/data first (highest blast radius), then language ecosystems,
# then OS/IDE noise. Anything sensitive must be near the top so it's obvious.
# =============================================================================

# --- Secrets ----------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/
credentials.json

# --- Data + models (never commit raw data or trained weights) --------------
# Ignore directory *contents* (not the directory itself) so .gitkeep can be
# force-included with `!`. Bare `data/raw/` would shadow the .gitkeep.
data/raw/*
data/interim/*
data/external/*
data/processed/*
!data/.gitkeep
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/external/.gitkeep
!data/processed/.gitkeep
models/checkpoints/
models/artifacts/
*.pt
*.pth
*.onnx
*.h5
*.pkl
*.joblib

# --- Honours archive (PII; lives outside the repo, but defensive) ---------
FIT4701-4702*/
*-2024S1-1698*/
_honours-archive/

# --- Working research artefacts (Deep Research outputs, scratch PDFs) -----
# These are inputs to docs/research/*, not deliverables. Keep them on disk
# but never in git.
*.pdf
!docs/**/*.pdf  # explicit allow if we ever publish a PDF deliverable

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
cython_debug/
.ruff_cache/
.uv/
.venv/
venv/
ENV/
env/

# --- Node / frontend --------------------------------------------------------
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/
out/
.vercel/
.turbo/
.swc/
*.tsbuildinfo
storybook-static/

# --- Notebooks --------------------------------------------------------------
.ipynb_checkpoints/

# --- Logs + observability ---------------------------------------------------
*.log
logs/
.langfuse/

# --- IDE / editor -----------------------------------------------------------
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.iml
*.swp
*.swo
.history/
.cursor/

# --- OS noise ---------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Misc -------------------------------------------------------------------
*.bak
*.tmp
*.orig
