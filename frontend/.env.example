# CardioRisk Co-Pilot frontend environment variables.
# Copy to `.env.local` for local dev; production values are wired in
# the Vercel project (Phase 8).

# ------------------------------------------------------------------
# Agent client mode
# ------------------------------------------------------------------
# When `true`, the agent client uses an in-memory fake instead of the
# Phase 4 FastAPI surface. Lets the screens render before the backend
# is deployed. Unset (or set to `false`) for live mode.
NEXT_PUBLIC_AGENT_MOCK=true

# Live API base URL. Required when NEXT_PUBLIC_AGENT_MOCK!=true.
# Phase 8 will wire this to the Hugging Face Spaces deployment, e.g.
# https://azheng-dev-cardiorisk-api.hf.space
NEXT_PUBLIC_API_BASE_URL=

# ------------------------------------------------------------------
# Phase 7 — Observability (ADR-024, free-tier only)
# ------------------------------------------------------------------
# Langfuse Cloud Hobby base URL. Public-only — the audit screen uses
# this to build a "View in Langfuse" deep-link from the per-case
# trace_id. Leave blank to hide the link (mock mode + any deploy
# without Langfuse credentials).
# Example: https://cloud.langfuse.com  (or your region's host)
NEXT_PUBLIC_LANGFUSE_TRACE_URL_BASE=

# Sentry DSN (browser side). When unset, every Sentry init is a no-op
# and the build is clean. Production wires this in the Vercel project.
NEXT_PUBLIC_SENTRY_DSN=

# Sentry transaction sampling rate for the browser (0..1). Defaults
# to 0.1 in prod. Lower for high-traffic deploys; raise for debugging.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Release identifier shown in Sentry. Optional — falls back to the
# Vercel git SHA at build time. Override for tagged releases.
NEXT_PUBLIC_APP_RELEASE=
NEXT_PUBLIC_APP_ENV=development

# Sentry source-map upload (server side only — set in Vercel project,
# never committed). Build still succeeds without these; source maps
# just aren't uploaded.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Sentry DSN (server side, for the small amount of server-rendered code
# in this Next app). Same DSN as NEXT_PUBLIC_SENTRY_DSN is fine.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Vercel automatically populates VERCEL_GIT_COMMIT_SHA at build time;
# the server config reads it and tags Sentry release accordingly.
