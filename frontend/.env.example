# CardioRisk Co-Pilot frontend environment variables.
# Copy to `.env.local` for local dev; production values are wired in
# the Vercel project (Phase 8).

# When `true`, the agent client uses an in-memory fake instead of the
# Phase 4 FastAPI surface. Lets the screens render before the backend
# is deployed. Unset (or set to `false`) for live mode.
NEXT_PUBLIC_AGENT_MOCK=true

# Live API base URL. Required when NEXT_PUBLIC_AGENT_MOCK!=true.
# Phase 8 will wire this to the Railway deployment, e.g.
# https://cardiorisk-api.up.railway.app
NEXT_PUBLIC_API_BASE_URL=
