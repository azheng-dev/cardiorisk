{
  "name": "cardiorisk-frontend",
  "version": "0.0.0",
  "private": true,
  "description": "CardioRisk Co-Pilot frontend. Pre-alpha; Next.js + Tailwind v4 + shadcn/ui land in Phase 5.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
