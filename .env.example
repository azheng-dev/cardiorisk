# =============================================================================
# CardioRisk Co-Pilot — environment template
# Copy to `.env` and fill in real values. `.env` is gitignored.
# Never commit real secrets. Pre-commit (gitleaks) will block obvious ones,
# but the only safe assumption is "secrets never leave my machine".
# =============================================================================

# --- Application -----------------------------------------------------------
# Runtime mode: dev | test | prod. Affects logging format and config defaults.
APP_ENV=dev

# --- LLM providers (Phase 3+) ---------------------------------------------
# Anthropic API key for Claude (default LLM in Phase 3).
ANTHROPIC_API_KEY=

# OpenAI API key (used as comparison model in Phase 6 multi-model eval).
OPENAI_API_KEY=

# Together API key (Llama-3.3-70B comparison model in Phase 6).
TOGETHER_API_KEY=

# --- Embeddings (Phase 3) -------------------------------------------------
# bge-m3 served locally needs no key; text-embedding-3-large needs OPENAI_API_KEY.
EMBEDDING_MODEL=bge-m3

# --- Supabase (Phase 3+) --------------------------------------------------
# Project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=
# Anon key for client-side reads.
SUPABASE_ANON_KEY=
# Service-role key for server-side writes. Server-only — never bundle in frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- Langfuse observability (Phase 7) -------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Frontend (Phase 5) ---------------------------------------------------
# Base URL of the FastAPI backend, used by the Next.js app.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
